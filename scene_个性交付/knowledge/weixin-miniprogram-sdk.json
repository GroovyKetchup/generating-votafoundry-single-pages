            "optional": false,
            "description": "位置坐标",
            "properties": [
              {
                "name": "latitude",
                "type": "number",
                "optional": true,
                "description": ""
              },
              {
                "name": "longitude",
                "type": "number",
                "optional": true,
                "description": ""
              },
              {
                "name": "altitude",
                "type": "number",
                "optional": true,
                "description": ""
              },
              {
                "name": "horizontalAccuracy",
                "type": "number",
                "optional": true,
                "description": ""
              },
              {
                "name": "verticalAccuracy",
                "type": "number",
                "optional": true,
                "description": ""
              },
              {
                "name": "speed",
                "type": "number",
                "optional": true,
                "description": ""
              },
              {
                "name": "address",
                "type": "string",
                "optional": true,
                "description": ""
              }
            ]
          },
          {
            "name": "timeout",
            "type": "number",
            "optional": true,
            "description": "超时时间（毫秒），默认 60000ms"
          }
        ]
      },
      "returns": {
        "type": "void",
        "properties": []
      }
    },
    {
      "name": "chooseLocation",
      "description": "打开地图让用户选择位置，返回所选位置坐标",
      "param": {
        "name": "opts",
        "type": "ChooseLocationOptions",
        "required": false,
        "properties": [
          {
            "name": "initLocation",
            "type": "GpsLocationDto",
            "optional": true,
            "description": "初始定位（可选）"
          },
          {
            "name": "timeout",
            "type": "number",
            "optional": true,
            "description": "超时时间（毫秒），默认 60000ms"
          }
        ]
      },
      "returns": {
        "type": "GpsLocationDto",
        "properties": [
          {
            "name": "latitude",
            "type": "number",
            "optional": true,
            "description": ""
          },
          {
            "name": "longitude",
            "type": "number",
            "optional": true,
            "description": ""
          },
          {
            "name": "altitude",
            "type": "number",
            "optional": true,
            "description": ""
